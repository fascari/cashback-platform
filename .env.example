# PostgreSQL
POSTGRES_DSN_CASHBACK=postgres://cashback:cashback@localhost:5432/cashback_service_db?sslmode=disable
POSTGRES_DSN_MINT=postgres://cashback:cashback@localhost:5432/mint_consumer_db?sslmode=disable
POSTGRES_DSN_BLOCKCHAIN=postgres://cashback:cashback@localhost:5432/blockchain_adapter_db?sslmode=disable

# NATS
NATS_URL=nats://localhost:4222

# Redis (used by blockchain-adapter for distributed nonce lock)
REDIS_URL=redis://localhost:6379

# gRPC
GRPC_BLOCKCHAIN_ADAPTER_ADDR=localhost:50051

# Ethereum (Sepolia testnet)
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet (DEV ONLY — never use on mainnet)
WALLET_MNEMONIC=test test test test test test test test test test test junk

# Server
HTTP_PORT=8080
GRPC_PORT=50051
