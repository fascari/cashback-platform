@startuml blockchain-toolchain
!theme mars
title Blockchain Toolchain (Development Pipeline)\nHow Solidity becomes callable Go code

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam padding 4

package "You write (once)" as WRITE #78350f {
    component "**CashbackToken.sol**\n~20 lines of Solidity" as SOL
}

package "mise run contracts:compile" as COMPILE #475569 {
    component "Hardhat" as HH
    artifact "CashbackToken.abi\n(JSON interface — like .proto)" as ABI
    artifact "CashbackToken.bin\n(EVM bytecode — the binary)" as BIN

    HH --> ABI
    HH --> BIN
}

package "mise run contracts:bindings" as BIND #475569 {
    component "**abigen**\n(like protoc for contracts)" as ABIGEN
    artifact "cashbacktoken.go\n(generated — never edit)" as GOFILE #34d399

    ABIGEN --> GOFILE
}

package "mise run contracts:deploy-sepolia" as DEPLOY #475569 {
    component "deploy.ts\n(Hardhat script)" as SCRIPT
    artifact "CONTRACT_ADDRESS=0x...\n(env var)" as ADDR #0284c7

    SCRIPT --> ADDR
}

package "Your Go code" as USE #1e3a5f {
    component "**usecase/token.go**\ntoken.Mint(auth, wallet, amount)" as UC
}

SOL --> HH
ABI --> ABIGEN
BIN --> ABIGEN
GOFILE --> UC
ADDR --> UC

@enduml

