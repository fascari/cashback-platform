@startuml wallet-key-hierarchy
!theme mars
title Wallet & Key Hierarchy\nHow one mnemonic generates the signing key used by the service

skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam padding 4

component "**Mnemonic**\n12 words stored in env var\nnever committed to git" as MN #ef4444

component "**Seed** (512 bits)\nBIP-39 derivation" as SEED #475569

component "**Master Key**\nBIP-32 HD wallet root" as MASTER #475569

component "**Child Private Key**\nm/44'/60'/0'/0/0\nstandard Ethereum path" as CHILD #f97316

component "**Public Key**\nECDSA secp256k1" as PUB #475569

component "**Wallet Address**\n0xAbCd...\nkeccak256(publicKey)[-20 bytes]" as ADDR #0284c7

component "**Signed Transaction**\ntx + ECDSA signature\nproves ownership without\nrevealing private key" as SIG #34d399

MN --> SEED : bip39.NewSeed
SEED --> MASTER : bip32.NewMasterKey
MASTER --> CHILD : Derive path
CHILD --> PUB : ecdsa.PublicKey
CHILD --> SIG : types.SignTx
PUB --> ADDR : hash + truncate

@enduml

