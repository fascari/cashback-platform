@startuml domain-events-flow
!theme mars
title Domain Events Flow

skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center

actor User
participant "cashback-service-api" as API
participant "NATS JetStream" as NATS
participant "mint-consumer" as MC
participant "blockchain-adapter" as BA
participant "Sepolia (EVM)" as Chain

== Purchase Registration ==

User -> API : POST /purchases
API -> API : persist purchase
note over API : purchase.created (internal)

== Cashback Approval ==

User -> API : POST /cashback/purchase/{id}
API -> API : calculate cashback (5%)
API -> API : cashback.approve()
API -> NATS : **cashback.approved** ①

== Token Minting ==

NATS -> MC : deliver cashback.approved
MC -> MC : idempotency check\n(processed_events)
MC -> MC : create MintRequest (pending)
MC -> BA : **gRPC MintToken** ②

BA -> BA : get & increment nonce\n(SELECT FOR UPDATE)
BA -> BA : build + sign transaction
BA -> Chain : **eth_sendRawTransaction** ③
Chain -> Chain : execute mint(wallet, amount)
Chain --> BA : tx hash + receipt

BA --> MC : MintResult{txHash, blockNumber}
MC -> MC : update MintRequest (completed)
MC -> MC : save ProcessedEvent ④
MC -> NATS : ACK

note over Chain : Transfer log emitted ⑤

@enduml

